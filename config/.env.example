# Copy to .env and fill in. Never commit the real .env.

# --- LLM / Agent runtime ---
ANTHROPIC_API_KEY=

# --- Aircraft (ADS-B Dual Redundancy Proxy) ---
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
ADSB_LOL_API_URL=https://api.adsb.lol/v2
FLIGHT_PROXY_CACHE_TTL_SEC=12

# --- Strategic Infrastructure / OSM Installations (Display-Only) ---
OSM_INSTALLATIONS_PATH=backend/ingestion/installations_osm.py

# --- Ships (AIS) ---
AISSTREAM_API_KEY=

# --- Fires ---
NASA_FIRMS_MAP_KEY=

# --- Geocoding ---
GEONAMES_USERNAME=

# --- Optional: licensed news API if you outgrow GDELT/RSS ---
NEWSAPI_KEY=

# --- Cloudflare Radar (internet outage signal) ---
CLOUDFLARE_RADAR_TOKEN=

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/bharat_sentinel

# --- Redis (pub/sub + cache) ---
REDIS_URL=redis://localhost:6379

# --- ACLED (optional, academic/nonprofit free tier) ---
ACLED_EMAIL=
ACLED_API_KEY=
